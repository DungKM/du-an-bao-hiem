# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trust-tool?retryWrites=true&w=majority

# NextAuth
AUTH_SECRET=change-this-to-a-random-long-string
NEXTAUTH_URL=http://localhost:3000

# Used only by scripts/seed-admin.js to create the first admin account
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PHONE=0900000000
ADMIN_SEED_PASSWORD=0900000000
ADMIN_SEED_NAME=Quan Tri Vien
